# Copy to .env (do not commit the real .env — already in .gitignore)

ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-local-dev

# Read by services/orchestration-api (core/config.py) when running outside docker-compose
MLFLOW_TRACKING_URI=http://localhost:5000
KEYCLOAK_URL=http://localhost:8080
LITELLM_GATEWAY_URL=http://localhost:4000
QDRANT_URL=http://localhost:6333
AUTH_ENABLED=false

# DVC remote (.dvc/config) — dataset versioning, S3-compatible.
# Defaults below match the local `minio` service in docker-compose.yml.
# Swap in real S3 credentials later if needed (only AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY change — DVC reads them like any boto3 client,
# nothing else in .dvc/config needs editing).
DVC_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Read by the ArgoCD Backstage plugin (app-config.yaml `argocd.appLocatorMethods`).
# Leave blank until infra/argocd has a real instance (roadmap.md Week 8-9) —
# the plugin's entity cards just won't load anything until then.
ARGOCD_USERNAME=
ARGOCD_PASSWORD=
